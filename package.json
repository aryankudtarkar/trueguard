{
  "name": "forgeguard",
  "displayName": "ForgeGuard",
  "description": "A trustworthy autonomous coding agent in VS Code, running on TrueForge.",
  "version": "0.1.0",
  "publisher": "forgeguard-dev",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src webview test tools scripts --max-warnings 0",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "design-lint": "node scripts/design-lint.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:int && npm run design-lint",
    "package": "vsce package",
    "trueforge": "npx @truefoundry/trueforge@latest",
    "setup": "node scripts/setup-trueforge.mjs",
    "fake-trueforge": "node tools/fake-trueforge/server.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.93.0",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "7.0.0",
    "dompurify": "3.2.3",
    "marked": "15.0.4",
    "zod": "3.24.1"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "keytar@7.9.0": true,
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
