{
  "name": "forgeguard",
  "displayName": "ForgeGuard",
  "description": "A trustworthy autonomous coding agent in VS Code, running on TrueForge.",
  "version": "0.1.0",
  "publisher": "forgeguard-dev",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onView:forgeguard.chatView",
    "onCommand:forgeguard.startTrueForge"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgeguard-container",
          "title": "ForgeGuard",
          "icon": "media/forgeguard.svg"
        }
      ]
    },
    "views": {
      "forgeguard-container": [
        {
          "type": "webview",
          "id": "forgeguard.chatView",
          "name": "Chat"
        },
        {
          "type": "tree",
          "id": "forgeguard.changesView",
          "name": "Changes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "forgeguard.chatView",
        "contents": "ForgeGuard puts a careful coding agent here. Start TrueForge to begin.\n[Start TrueForge](command:forgeguard.startTrueForge)\nNothing is written to your files without your review."
      },
      {
        "view": "forgeguard.changesView",
        "contents": "No changes waiting.\nWhen the agent proposes an edit, it appears here for review."
      }
    ],
    "commands": [
      {
        "command": "forgeguard.startTrueForge",
        "title": "ForgeGuard: Start TrueForge",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.stopTrueForge",
        "title": "ForgeGuard: Stop TrueForge",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.newChat",
        "title": "ForgeGuard: New Chat",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.stopTurn",
        "title": "ForgeGuard: Stop Turn",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.switchModel",
        "title": "ForgeGuard: Switch Model",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.showSessionLog",
        "title": "ForgeGuard: Show Session Log",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.reviewNextChange",
        "title": "ForgeGuard: Review Next Change",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.acceptHunk",
        "title": "ForgeGuard: Accept Hunk",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.rejectHunk",
        "title": "ForgeGuard: Reject Hunk",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.acceptAll",
        "title": "ForgeGuard: Accept All",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.rejectAll",
        "title": "ForgeGuard: Reject All",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.applyChanges",
        "title": "ForgeGuard: Apply Selected Changes",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.inlineEdit",
        "title": "ForgeGuard: Inline Edit Selection",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.review.openDiff",
        "title": "ForgeGuard: Open Diff",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.dev.corruptNextWrite",
        "title": "ForgeGuard: Dev: Corrupt Next Write",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.dev.inject.fail429",
        "title": "ForgeGuard: Dev: Inject 429 (rate limit)",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.dev.inject.fail503",
        "title": "ForgeGuard: Dev: Inject 503 (server error)",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.dev.inject.fail401",
        "title": "ForgeGuard: Dev: Inject 401 (bad credentials)",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.dev.inject.stall",
        "title": "ForgeGuard: Dev: Inject a stalled response",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.dev.inject.clear",
        "title": "ForgeGuard: Dev: Clear injected faults",
        "category": "ForgeGuard"
      }
    ],
    "keybindings": [
      {
        "command": "forgeguard.newChat",
        "key": "ctrl+shift+alt+n",
        "mac": "cmd+shift+alt+n"
      },
      {
        "command": "forgeguard.stopTurn",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s"
      },
      {
        "command": "forgeguard.acceptHunk",
        "key": "ctrl+shift+alt+a",
        "mac": "cmd+shift+alt+a"
      },
      {
        "command": "forgeguard.rejectHunk",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r"
      },
      {
        "command": "forgeguard.inlineEdit",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "forgeguard.acceptAll",
          "when": "view == forgeguard.changesView",
          "group": "navigation@1"
        },
        {
          "command": "forgeguard.rejectAll",
          "when": "view == forgeguard.changesView",
          "group": "navigation@2"
        },
        {
          "command": "forgeguard.applyChanges",
          "when": "view == forgeguard.changesView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "forgeguard.acceptHunk",
          "when": "view == forgeguard.changesView && viewItem == forgeguard.hunk",
          "group": "inline@1"
        },
        {
          "command": "forgeguard.rejectHunk",
          "when": "view == forgeguard.changesView && viewItem == forgeguard.hunk",
          "group": "inline@2"
        },
        {
          "command": "forgeguard.acceptHunk",
          "when": "view == forgeguard.changesView && viewItem == forgeguard.file",
          "group": "inline@1"
        },
        {
          "command": "forgeguard.rejectHunk",
          "when": "view == forgeguard.changesView && viewItem == forgeguard.file",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "forgeguard.review.openDiff",
          "when": "false"
        },
        {
          "command": "forgeguard.dev.corruptNextWrite",
          "when": "false"
        },
        {
          "command": "forgeguard.dev.inject.clear",
          "when": "false"
        },
        {
          "command": "forgeguard.dev.inject.fail429",
          "when": "false"
        },
        {
          "command": "forgeguard.dev.inject.fail503",
          "when": "false"
        },
        {
          "command": "forgeguard.dev.inject.fail401",
          "when": "false"
        },
        {
          "command": "forgeguard.dev.inject.stall",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "ForgeGuard",
      "properties": {
        "forgeguard.trueforge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Address of the local TrueForge server."
        },
        "forgeguard.models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string",
                "description": "TrueForge model FQN, e.g. openai/gpt-4o-mini"
              }
            },
            "required": [
              "id",
              "label",
              "ref"
            ]
          },
          "default": [],
          "description": "Ordered model profiles. Index 0 is the primary model; failures fall over to the next."
        },
        "forgeguard.activeModelIndex": {
          "type": "integer",
          "default": 0,
          "description": "Index into forgeguard.models used for new turns."
        },
        "forgeguard.toolOutputCapBytes": {
          "type": "integer",
          "default": 16384,
          "description": "Maximum size of a single tool result returned to the agent, in bytes."
        },
        "forgeguard.allowSecretReads": {
          "type": "boolean",
          "default": false,
          "description": "Allow the agent to read secret-looking files (.env, *.pem, id_rsa) inside the workspace."
        },
        "forgeguard.commandTimeoutSec": {
          "type": "integer",
          "default": 120,
          "description": "Default timeout for agent-run terminal commands."
        },
        "forgeguard.dev.enableFaultInjection": {
          "type": "boolean",
          "default": false,
          "description": "Enable development fault-injection commands (429, 503, timeout, 401)."
        },
        "forgeguard.contextBudgetBytes": {
          "type": "integer",
          "default": 16384,
          "description": "Maximum size of the workspace context attached to a message, in bytes."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "forgeguard.gettingStarted",
        "title": "Get started with ForgeGuard",
        "description": "ForgeGuard puts a careful coding agent in your editor. Nothing is written to your files without your review.",
        "steps": [
          {
            "id": "forgeguard.start",
            "title": "Start TrueForge",
            "description": "TrueForge is the agent harness ForgeGuard talks to. Start it and the chat becomes usable.\n[Start TrueForge](command:forgeguard.startTrueForge)",
            "media": "media/forgeguard.svg",
            "completionEvents": [
              "onCommand:forgeguard.startTrueForge"
            ]
          },
          {
            "id": "forgeguard.models",
            "title": "Add your models",
            "description": "ForgeGuard needs at least one model. The first one is the primary; the others are the fallbacks used when a provider fails.\n[Open the model settings](command:workbench.action.openSettings?%22forgeguard.models%22)",
            "media": "media/forgeguard.svg",
            "completionEvents": [
              "onCommand:workbench.action.openSettings"
            ]
          },
          {
            "id": "forgeguard.task",
            "title": "Try a first task",
            "description": "Ask for something small. The agent reads your files, proposes a change, and you accept or reject each hunk before anything is written.\n[Open the chat](command:forgeguard.chatView.focus)",
            "media": "media/forgeguard.svg",
            "completionEvents": [
              "onCommand:forgeguard.chatView.focus"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src webview test tools scripts --max-warnings 0",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:int": "npm run build && node scripts/build-integration.mjs && node scripts/test-integration.mjs",
    "design-lint": "node scripts/design-lint.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:int && npm run design-lint",
    "package": "vsce package",
    "trueforge": "npx @truefoundry/trueforge@latest",
    "setup": "node scripts/setup-trueforge.mjs",
    "fake-trueforge": "node tools/fake-trueforge/server.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.93.0",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "@vitest/coverage-v8": "2.1.8",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "7.0.0",
    "dompurify": "3.2.3",
    "marked": "15.0.4",
    "zod": "3.24.1"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "keytar@7.9.0": true,
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forgeguard-dev/forgeguard.git"
  },
  "homepage": "https://github.com/forgeguard-dev/forgeguard#readme",
  "bugs": {
    "url": "https://github.com/forgeguard-dev/forgeguard/issues"
  }
}
