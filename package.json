{
  "name": "trueguard",
  "displayName": "TrueGuard",
  "description": "A trustworthy autonomous coding agent in VS Code, running on TrueForge.",
  "version": "0.1.0",
  "publisher": "aryankudtarkar",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onWalkthrough:trueguard.gettingStarted",
    "onView:trueguard.chatView",
    "onCommand:trueguard.startTrueForge",
    "onCommand:trueguard.checkSetup",
    "onCommand:trueguard.configureProviders"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trueguard-container",
          "title": "TrueGuard",
          "icon": "media/trueguard.svg"
        }
      ]
    },
    "views": {
      "trueguard-container": [
        {
          "type": "webview",
          "id": "trueguard.chatView",
          "name": "Chat"
        },
        {
          "type": "tree",
          "id": "trueguard.changesView",
          "name": "Changes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "trueguard.chatView",
        "contents": "TrueGuard puts a careful coding agent here. Start TrueForge to begin.\n[Start TrueForge](command:trueguard.startTrueForge)\nNothing is written to your files without your review."
      },
      {
        "view": "trueguard.changesView",
        "contents": "No changes waiting.\nWhen the agent proposes an edit, it appears here for review."
      }
    ],
    "commands": [
      {
        "command": "trueguard.checkSetup",
        "title": "TrueGuard: Check Setup",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.startOnboarding",
        "title": "TrueGuard: Set Up (providers and models)",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.startTrueForge",
        "title": "TrueGuard: Start TrueForge",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.stopTrueForge",
        "title": "TrueGuard: Stop TrueForge",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.configureProviders",
        "title": "TrueGuard: Configure Providers",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.switchMode",
        "title": "TrueGuard: Switch Mode (Fast / Thinking)",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.newChat",
        "title": "TrueGuard: New Chat",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.stopTurn",
        "title": "TrueGuard: Stop Turn",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.switchModel",
        "title": "TrueGuard: Switch Model",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.showSessionLog",
        "title": "TrueGuard: Show Session Log",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.reviewNextChange",
        "title": "TrueGuard: Review Next Change",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.acceptHunk",
        "title": "TrueGuard: Accept Hunk",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.rejectHunk",
        "title": "TrueGuard: Reject Hunk",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.acceptAll",
        "title": "TrueGuard: Accept All",
        "category": "TrueGuard",
        "icon": "$(check-all)"
      },
      {
        "command": "trueguard.rejectAll",
        "title": "TrueGuard: Reject All",
        "category": "TrueGuard",
        "icon": "$(close-all)"
      },
      {
        "command": "trueguard.applyChanges",
        "title": "TrueGuard: Apply Selected Changes",
        "category": "TrueGuard",
        "icon": "$(play)"
      },
      {
        "command": "trueguard.inlineEdit",
        "title": "TrueGuard: Inline Edit Selection",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.review.openDiff",
        "title": "TrueGuard: Open Diff",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.dev.corruptNextWrite",
        "title": "TrueGuard: Dev: Corrupt Next Write",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.dev.inject.fail429",
        "title": "TrueGuard: Dev: Inject 429 (rate limit)",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.dev.inject.fail503",
        "title": "TrueGuard: Dev: Inject 503 (server error)",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.dev.inject.fail401",
        "title": "TrueGuard: Dev: Inject 401 (bad credentials)",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.dev.inject.stall",
        "title": "TrueGuard: Dev: Inject a stalled response",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.dev.inject.clear",
        "title": "TrueGuard: Dev: Clear injected faults",
        "category": "TrueGuard"
      },
      {
        "command": "trueguard.revertChange",
        "title": "TrueGuard: Revert Last Change",
        "category": "TrueGuard"
      }
    ],
    "keybindings": [
      {
        "command": "trueguard.newChat",
        "key": "ctrl+shift+alt+n",
        "mac": "cmd+shift+alt+n"
      },
      {
        "command": "trueguard.stopTurn",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s"
      },
      {
        "command": "trueguard.acceptHunk",
        "key": "ctrl+shift+alt+a",
        "mac": "cmd+shift+alt+a"
      },
      {
        "command": "trueguard.rejectHunk",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r"
      },
      {
        "command": "trueguard.inlineEdit",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "trueguard.applyChanges",
          "when": "view == trueguard.changesView",
          "group": "navigation@1"
        },
        {
          "command": "trueguard.acceptAll",
          "when": "view == trueguard.changesView",
          "group": "navigation@2"
        },
        {
          "command": "trueguard.rejectAll",
          "when": "view == trueguard.changesView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "trueguard.acceptHunk",
          "when": "view == trueguard.changesView && viewItem == trueguard.hunk",
          "group": "inline@1"
        },
        {
          "command": "trueguard.rejectHunk",
          "when": "view == trueguard.changesView && viewItem == trueguard.hunk",
          "group": "inline@2"
        },
        {
          "command": "trueguard.acceptHunk",
          "when": "view == trueguard.changesView && viewItem == trueguard.file",
          "group": "inline@1"
        },
        {
          "command": "trueguard.rejectHunk",
          "when": "view == trueguard.changesView && viewItem == trueguard.file",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "trueguard.review.openDiff",
          "when": "false"
        },
        {
          "command": "trueguard.dev.corruptNextWrite",
          "when": "false"
        },
        {
          "command": "trueguard.dev.inject.clear",
          "when": "false"
        },
        {
          "command": "trueguard.dev.inject.fail429",
          "when": "false"
        },
        {
          "command": "trueguard.dev.inject.fail503",
          "when": "false"
        },
        {
          "command": "trueguard.dev.inject.fail401",
          "when": "false"
        },
        {
          "command": "trueguard.dev.inject.stall",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "TrueGuard",
      "properties": {
        "trueguard.trueforge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Address of the local TrueForge server."
        },
        "trueguard.models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string",
                "description": "TrueForge model FQN, e.g. openai/gpt-4o-mini"
              }
            },
            "required": [
              "id",
              "label",
              "ref"
            ]
          },
          "default": [],
          "description": "Ordered model profiles. Index 0 is the primary model; failures fall over to the next."
        },
        "trueguard.toolOutputCapBytes": {
          "type": "integer",
          "default": 16384,
          "description": "Maximum size of a single tool result returned to the agent, in bytes."
        },
        "trueguard.allowSecretReads": {
          "type": "boolean",
          "default": false,
          "description": "Allow the agent to read secret-looking files (.env, *.pem, id_rsa) inside the workspace."
        },
        "trueguard.commandTimeoutSec": {
          "type": "integer",
          "default": 120,
          "description": "Default timeout for agent-run terminal commands."
        },
        "trueguard.dev.enableFaultInjection": {
          "type": "boolean",
          "default": false,
          "description": "Enable development fault-injection commands (429, 503, timeout, 401)."
        },
        "trueguard.contextBudgetBytes": {
          "type": "integer",
          "default": 16384,
          "description": "Maximum size of the workspace context attached to a message, in bytes."
        },
        "trueguard.failover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Continue a turn on the next model when the provider fails (rate limit, server error, timeout)."
        },
        "trueguard.failover.breakerCooldownSec": {
          "type": "integer",
          "default": 60,
          "description": "How long a failed model stays out before it is tried again."
        },
        "trueguard.mode": {
          "type": "string",
          "enum": [
            "fast",
            "thinking"
          ],
          "default": "fast",
          "description": "The active mode: Fast (quick answers) or Thinking (deeper reasoning)."
        },
        "trueguard.modes.fast.models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string",
                "description": "The model identifier TrueForge expects, e.g. groq/gpt-oss-120b."
              }
            },
            "required": [
              "id",
              "label",
              "ref"
            ]
          },
          "default": [],
          "description": "The failover chain of the Fast mode."
        },
        "trueguard.modes.thinking.models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string",
                "description": "The model identifier TrueForge expects, e.g. groq/gpt-oss-120b."
              }
            },
            "required": [
              "id",
              "label",
              "ref"
            ]
          },
          "default": [],
          "description": "The failover chain of the Thinking mode."
        },
        "trueguard.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "",
          "description": "Reasoning effort sent with the model in Thinking mode. Empty = the mode's default."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "trueguard.gettingStarted",
        "title": "Get started with TrueGuard",
        "description": "TrueGuard puts a careful coding agent in your editor. Nothing is written to your files without your review.",
        "steps": [
          {
            "id": "trueguard.check",
            "title": "Check that everything is ready",
            "description": "One command tells you whether TrueForge, the models and the editor tools are ready \u2014 and what to do if they are not.\n[Check the setup](command:trueguard.checkSetup)",
            "media": "media/trueguard.svg",
            "completionEvents": [
              "onCommand:trueguard.checkSetup"
            ]
          },
          {
            "id": "trueguard.start",
            "title": "Start TrueForge",
            "description": "TrueForge is the agent harness TrueGuard talks to. Start it and the chat becomes usable.\n[Start TrueForge](command:trueguard.startTrueForge)",
            "media": "media/trueguard.svg",
            "completionEvents": [
              "onCommand:trueguard.startTrueForge"
            ]
          },
          {
            "id": "trueguard.providers",
            "title": "Add your providers",
            "description": "TrueGuard talks to your model provider. Paste your Groq and NVIDIA NIM keys once: they are stored in the extension's secret storage and registered in TrueForge. No key is ever written to your settings or your repository.\n[Set up the providers](command:trueguard.startOnboarding)",
            "media": "media/trueguard.svg",
            "completionEvents": [
              "onCommand:trueguard.startOnboarding"
            ]
          },
          {
            "id": "trueguard.models",
            "title": "Add your models",
            "description": "TrueGuard needs at least one model. The first one is the primary; the others are the fallbacks used when a provider fails.\n[Open the model settings](command:workbench.action.openSettings?%22trueguard.models%22)",
            "media": "media/trueguard.svg",
            "completionEvents": [
              "onCommand:workbench.action.openSettings"
            ]
          },
          {
            "id": "trueguard.task",
            "title": "Try a first task",
            "description": "Ask for something small. The agent reads your files, proposes a change, and you accept or reject each hunk before anything is written.\n[Open the chat](command:trueguard.chatView.focus)",
            "media": "media/trueguard.svg",
            "completionEvents": [
              "onCommand:trueguard.chatView.focus"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src webview test tools scripts --max-warnings 0",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:int": "npm run build && node scripts/build-integration.mjs && node scripts/test-integration.mjs",
    "design-lint": "node scripts/design-lint.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:int && npm run design-lint",
    "package": "vsce package --no-dependencies",
    "trueforge": "npx @truefoundry/trueforge@latest",
    "setup": "node scripts/setup-trueforge.mjs",
    "fake-trueforge": "node tools/fake-trueforge/server.mjs",
    "dev": "node scripts/dev.mjs",
    "fake-provider": "node spikes/fake-openai.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.93.0",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "@vitest/coverage-v8": "2.1.8",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "7.0.0",
    "dompurify": "3.2.3",
    "marked": "15.0.4",
    "zod": "3.24.1"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "keytar@7.9.0": true,
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aryankudtarkar/trueguard.git"
  },
  "homepage": "https://github.com/aryankudtarkar/trueguard#readme",
  "bugs": {
    "url": "https://github.com/aryankudtarkar/trueguard/issues"
  }
}
