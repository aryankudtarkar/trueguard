{
  "name": "forgeguard",
  "displayName": "ForgeGuard",
  "description": "A trustworthy autonomous coding agent in VS Code, running on TrueForge.",
  "version": "0.1.0",
  "publisher": "forgeguard-dev",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onView:forgeguard.chatView",
    "onCommand:forgeguard.startTrueForge"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgeguard-container",
          "title": "ForgeGuard",
          "icon": "media/forgeguard.svg"
        }
      ]
    },
    "views": {
      "forgeguard-container": [
        {
          "type": "webview",
          "id": "forgeguard.chatView",
          "name": "Chat"
        },
        {
          "type": "tree",
          "id": "forgeguard.changesView",
          "name": "Changes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "forgeguard.chatView",
        "contents": "ForgeGuard puts a careful coding agent here. Start TrueForge to begin.\n[Start TrueForge](command:forgeguard.startTrueForge)\nNothing is written to your files without your review."
      }
    ],
    "commands": [
      {
        "command": "forgeguard.startTrueForge",
        "title": "ForgeGuard: Start TrueForge",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.stopTrueForge",
        "title": "ForgeGuard: Stop TrueForge",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.newChat",
        "title": "ForgeGuard: New Chat",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.stopTurn",
        "title": "ForgeGuard: Stop Turn",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.switchModel",
        "title": "ForgeGuard: Switch Model",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.showSessionLog",
        "title": "ForgeGuard: Show Session Log",
        "category": "ForgeGuard"
      },
      {
        "command": "forgeguard.reviewNextChange",
        "title": "ForgeGuard: Review Next Change",
        "category": "ForgeGuard"
      }
    ],
    "keybindings": [
      {
        "command": "forgeguard.newChat",
        "key": "ctrl+shift+alt+n",
        "mac": "cmd+shift+alt+n"
      },
      {
        "command": "forgeguard.stopTurn",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s"
      }
    ],
    "configuration": {
      "title": "ForgeGuard",
      "properties": {
        "forgeguard.trueforge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Address of the local TrueForge server."
        },
        "forgeguard.models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string",
                "description": "TrueForge model FQN, e.g. openai/gpt-4o-mini"
              }
            },
            "required": [
              "id",
              "label",
              "ref"
            ]
          },
          "default": [],
          "description": "Ordered model profiles. Index 0 is the primary model; failures fall over to the next."
        },
        "forgeguard.activeModelIndex": {
          "type": "integer",
          "default": 0,
          "description": "Index into forgeguard.models used for new turns."
        },
        "forgeguard.toolOutputCapBytes": {
          "type": "integer",
          "default": 16384,
          "description": "Maximum size of a single tool result returned to the agent, in bytes."
        },
        "forgeguard.allowSecretReads": {
          "type": "boolean",
          "default": false,
          "description": "Allow the agent to read secret-looking files (.env, *.pem, id_rsa) inside the workspace."
        },
        "forgeguard.commandTimeoutSec": {
          "type": "integer",
          "default": 120,
          "description": "Default timeout for agent-run terminal commands."
        },
        "forgeguard.dev.enableFaultInjection": {
          "type": "boolean",
          "default": false,
          "description": "Enable development fault-injection commands (429, 503, timeout, 401)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src webview test tools scripts --max-warnings 0",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:int": "npm run build && node scripts/build-integration.mjs && node scripts/test-integration.mjs",
    "design-lint": "node scripts/design-lint.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:int && npm run design-lint",
    "package": "vsce package",
    "trueforge": "npx @truefoundry/trueforge@latest",
    "setup": "node scripts/setup-trueforge.mjs",
    "fake-trueforge": "node tools/fake-trueforge/server.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.93.0",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "@vitest/coverage-v8": "2.1.8",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "7.0.0",
    "dompurify": "3.2.3",
    "marked": "15.0.4",
    "zod": "3.24.1"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "keytar@7.9.0": true,
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
